# Let the session user start the X server.
#
# vstos-session.service runs as an unprivileged user, and Xorg.wrap refuses to
# start for anybody who is not physically logged in on a console. The service does
# hold a real logind session (PAMName=login in the unit), but the wrapper's own
# check predates that and looks only at the tty it was invoked from.
#
# The exposure this opens is "a local user can start an X server". On a machine
# whose only user is the audio session, that is not an exposure.
allowed_users=anybody
needs_root_rights=yes
